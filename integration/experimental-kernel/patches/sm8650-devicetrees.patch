diff --git a/qcom/houji-pinctrl.dtsi b/qcom/houji-pinctrl.dtsi
index fcee716..323e53a 100644
--- a/qcom/houji-pinctrl.dtsi
+++ b/qcom/houji-pinctrl.dtsi
@@ -126,3 +126,33 @@
 		};
 	}; //wifi
 }; //tlmm
+
+/* UART audio switch states from the houji prebuilt DTBO. */
+&tlmm {
+	sbu_uart_en_ctrl {
+		sbu_uart_en_idle: uart_audio_en_idle {
+			mux {
+				function = "gpio";
+				pins = "gpio53";
+			};
+			config {
+				output-low;
+				bias-pull-down;
+				drive-strength = <2>;
+				pins = "gpio53";
+			};
+		};
+		sbu_uart_en_active: uart_audio_en_active {
+			mux {
+				function = "gpio";
+				pins = "gpio53";
+			};
+			config {
+				output-high;
+				bias-disable;
+				drive-strength = <2>;
+				pins = "gpio53";
+			};
+		};
+	};
+};
