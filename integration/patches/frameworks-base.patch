+package com.android.systemui.statusbar.phone;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.view.Gravity;
+import android.widget.FrameLayout;
+
+import com.android.systemui.plugins.DarkIconDispatcher;
+
+import org.lineageos.internal.statusbar.LineageStatusBarItem;
+import org.lineageos.internal.statusbar.NetworkTraffic;
+
+import java.util.ArrayList;
+
+/** Attaches the SDK traffic indicator to the display's tint and visibility lifecycle. */
+public final class NetworkTrafficView extends FrameLayout
+        implements LineageStatusBarItem.Manager, DarkIconDispatcher.DarkReceiver {
+    private final DarkIconDispatcher mDarkIconDispatcher;
+    private final ArrayList<LineageStatusBarItem.DarkReceiver> mDarkReceivers = new ArrayList<>();
+    private final ArrayList<LineageStatusBarItem.VisibilityReceiver> mVisibilityReceivers =
+            new ArrayList<>();
+    private ArrayList<Rect> mTintAreas = new ArrayList<>();
+    private float mDarkIntensity;
+    private int mTint = DarkIconDispatcher.DEFAULT_ICON_TINT;
+
+    public NetworkTrafficView(Context context, int position, DarkIconDispatcher dispatcher) {
+        super(context);
+        mDarkIconDispatcher = dispatcher;
+        NetworkTraffic traffic = new NetworkTraffic(context);
+        traffic.setViewPosition(position);
+        traffic.setGravity(Gravity.CENTER_VERTICAL);
+        addView(traffic, new LayoutParams(LayoutParams.WRAP_CONTENT,
+                LayoutParams.MATCH_PARENT, Gravity.CENTER_VERTICAL));
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        mDarkIconDispatcher.addDarkReceiver(this);
+    }
+
+    @Override
+    protected void onLayout(boolean changed, int left, int top, int right, int bottom) {
+        super.onLayout(changed, left, top, right, bottom);
+        if (changed && isAttachedToWindow()) {
+            mDarkIconDispatcher.applyDark(this);
+        }
+    }
+
+    @Override
+    protected void onDetachedFromWindow() {
+        mDarkIconDispatcher.removeDarkReceiver(this);
+        super.onDetachedFromWindow();
+    }
+
+    @Override
+    public void onDarkChanged(ArrayList<Rect> areas, float darkIntensity, int tint) {
+        mTintAreas = new ArrayList<>(areas);
+        mDarkIntensity = darkIntensity;
+        mTint = tint;
+        for (LineageStatusBarItem.DarkReceiver receiver : mDarkReceivers) {
+            dispatchTint(receiver);
+        }
+    }
+
+    private void dispatchTint(LineageStatusBarItem.DarkReceiver receiver) {
+        receiver.onDarkChanged(mTintAreas, mDarkIntensity,
+                DarkIconDispatcher.getTint(mTintAreas, this, mTint));
+    }
