+
+/** Observe both the Lineage button preference and the actual Android brightness mode. */
+@Composable
+private fun AutoBrightnessButton(enabled: Boolean) {
+    val context = LocalContext.current
+    if (!context.resources.getBoolean(com.android.internal.R.bool.config_automatic_brightness_available)) {
+        return
+    }
+    val resolver = context.contentResolver
+    fun readState(): Pair<Boolean, Boolean> =
+        (LineageSettings.Secure.getIntForUser(
+            resolver, LineageSettings.Secure.QS_SHOW_AUTO_BRIGHTNESS,
+            1, UserHandle.USER_CURRENT,
+        ) != 0) to (Settings.System.getIntForUser(
+            resolver, Settings.System.SCREEN_BRIGHTNESS_MODE,
+            Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL, UserHandle.USER_CURRENT,
+        ) == Settings.System.SCREEN_BRIGHTNESS_MODE_AUTOMATIC)
+    var state by remember(context) { mutableStateOf(readState()) }
+    DisposableEffect(context) {
+        val observer = object : ContentObserver(Handler(Looper.getMainLooper())) {
+            override fun onChange(selfChange: Boolean) {
+                state = readState()
+            }
+        }
+        listOf(
+            LineageSettings.Secure.getUriFor(LineageSettings.Secure.QS_SHOW_AUTO_BRIGHTNESS),
+            Settings.System.getUriFor(Settings.System.SCREEN_BRIGHTNESS_MODE),
+        ).forEach { resolver.registerContentObserver(it, false, observer, UserHandle.USER_ALL) }
+        state = readState()
+        onDispose { resolver.unregisterContentObserver(observer) }
+    }
+    val (showButton, automatic) = state
+    if (showButton) {
+        IconToggleButton(
+            checked = automatic,
+            enabled = enabled,
+            onCheckedChange = { checked ->
+                Settings.System.putIntForUser(
+                    resolver, Settings.System.SCREEN_BRIGHTNESS_MODE,
+                    if (checked) Settings.System.SCREEN_BRIGHTNESS_MODE_AUTOMATIC
+                    else Settings.System.SCREEN_BRIGHTNESS_MODE_MANUAL,
+                    UserHandle.USER_CURRENT,
+                )
+            },
+            modifier = Modifier.sysuiResTag("auto_brightness_toggle"),
+        ) {
+            MaterialIcon(
+                painter = painterResource(
+                    if (automatic) R.drawable.ic_qs_brightness_auto_on
+                    else R.drawable.ic_qs_brightness_auto_off
+                ),
+                contentDescription = stringResource(R.string.accessibility_adaptive_brightness),
+            )
+        }
+    }
+}
