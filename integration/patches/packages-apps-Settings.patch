@@ -0,0 +1,73 @@
+package com.android.settings.houji;
+
+import android.app.Activity;
+import android.os.Bundle;
+import android.os.IBinder;
+import android.os.Parcel;
+import android.view.View;
+import android.widget.Button;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+// Temporary platform-signed UI for the existing IAdbRootService.
+// Launching this activity never changes the service state.
+public final class AdbRootActivity extends Activity {
+    private TextView status;
+
+    @Override public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        LinearLayout layout = new LinearLayout(this);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        layout.setPadding(40, 100, 40, 40);
+        status = new TextView(this);
+        layout.addView(status);
+        TextView description = new TextView(this);
+        description.setText("仅用于本机相机故障诊断。开启后，已授权的电脑可以执行 adb root 获得系统权限。诊断结束后请关闭。此工具不会安装 Magisk、修改启动镜像或取消 USB 授权认证。");
+        layout.addView(description);
+        for (final boolean enabled : new boolean[] {true, false}) {
+            Button button = new Button(this);
+            button.setText(enabled ? "开启 ADB Root 调试" : "关闭 ADB Root 调试");
+            button.setOnClickListener(new View.OnClickListener() {
+                @Override public void onClick(View view) {
+                    try {
+                        call(2, enabled);
+                        refresh();
+                    } catch (Exception e) {
+                        status.setText("操作失败：" + e);
+                    }
+                }
+            });
+            layout.addView(button);
+        }
+        setContentView(layout);
+        refresh();
+    }
+
+    private void refresh() {
+        try {
+            status.setText("系统支持：" + call(1, null) + "\n当前开启：" + call(3, null));
+        } catch (Exception e) {
+            status.setText("读取失败：" + e);
+        }
+    }
+
+    private boolean call(int transaction, Boolean enabled) throws Exception {
+        IBinder service = (IBinder) Class.forName("android.os.ServiceManager")
+            .getMethod("getService", String.class).invoke(null, "adbroot_service");
+        if (service == null) throw new IllegalStateException("adbroot_service 不存在");
+        Parcel data = Parcel.obtain();
+        Parcel reply = Parcel.obtain();
+        try {
+            data.writeInterfaceToken("android.adbroot.IAdbRootService");
+            if (enabled != null) data.writeInt(enabled ? 1 : 0);
+            if (!service.transact(transaction, data, reply, 0)) {
+                throw new IllegalStateException("接口不支持该操作");
+            }
+            reply.readException();
+            return enabled != null ? enabled : reply.readInt() != 0;
+        } finally {
+            reply.recycle();
+            data.recycle();
+        }
+    }
+}
