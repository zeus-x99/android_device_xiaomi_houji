# FOD wake events are supplied by the touch driver and enabled through its HAL.
allow hal_sensors_default sysfs_tp_fodstatus:file r_file_perms;
allow hal_sensors_default hal_touchfeature_xiaomi_service:service_manager find;
binder_call(hal_sensors_default, hal_touchfeature_xiaomi_default)
binder_use(hal_sensors_default)
get_prop(hal_sensors_default, vendor_sensors_prop)
